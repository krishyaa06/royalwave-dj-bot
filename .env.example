# ── Required ─────────────────────────────────────────
DISCORD_TOKEN=your-bot-token-here
CLIENT_ID=your-application-id-here

# ── Recommended ──────────────────────────────────────
# Your Discord user ID(s), comma separated. Owners can run /genkey.
OWNER_IDS=

# ── Optional ─────────────────────────────────────────
# Register commands instantly in one server while developing.
GUILD_ID=

# Web panel API (live stats + settings in the Prism Bots Panel). 0 = off.
PANEL_API_PORT=0
PANEL_ORIGIN=https://krishyaa06.github.io

# Where the "Buy Premium" buttons point (Razorpay / UPI / Ko-fi / Patreon page).
PREMIUM_BUY_URL=

# Fixed SoundCloud client id (otherwise one is fetched automatically).
SOUNDCLOUD_CLIENT_ID=
